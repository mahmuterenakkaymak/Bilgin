<!-- WinSW template of the Bilgin service (PLAN R8-22). `python -m nl2sql service-xml` fills the
     placeholders and writes the result next to WinSW-x64.exe. No secret belongs in this file:
     model keys live DPAPI-encrypted under NL2SQL_HOME\secrets, database connections in the app
     database (R8-23), so the service reads them from its own data root at startup. -->
<service>
  <id>Bilgin</id>
  <name>@DISPLAY_NAME@</name>
  <description>@DESCRIPTION@</description>
  <executable>@PYTHON_EXE@</executable>
  <arguments>@ARGUMENTS@</arguments>
  <workingdirectory>@REPO@</workingdirectory>
  <env key="NL2SQL_HOME" value="@HOME@" />
  <env key="NL2SQL_LANG" value="@LANG@" />
  <env key="NL2SQL_BACKEND" value="@BACKEND@" />
  @MODEL_ENV@
  @DATASETS_ENV@
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <serviceaccount>
    <username>NT SERVICE\Bilgin</username>
  </serviceaccount>
  <logpath>@LOG_DIR@</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
