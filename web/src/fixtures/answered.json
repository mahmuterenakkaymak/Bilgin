  "row_count": 5,
  "truncated": false,
  "sql": "SELECT s.STOK_KODU, t.STOK_ADI, SUM(s.STHAR_GCMIK) AS SATIS_MIKTARI FROM TBLSTHAR s JOIN TBLSTSABIT t ON t.STOK_KODU = s.STOK_KODU WHERE s.STHAR_HTUR = 'S' AND s.STHAR_TARIH >= '2026-09-01' AND s.STHAR_TARIH < '2026-10-01' GROUP BY s.STOK_KODU, t.STOK_ADI ORDER BY SATIS_MIKTARI DESC, s.STOK_KODU",
